# URL base de antua-api (sin barra final).
# En desarrollo el front llama a /api y Vite reenvía a esta URL (la API no habilita CORS todavía).
# En producción el cliente Axios usa esta URL directamente: la API debe permitir CORS
# y exponer el header X-Guest-Token (exposedHeaders) para que funcione el carrito de invitado.
VITE_API_URL=http://localhost:3000

# Opcional: adónde reenvían `vite` y `vite preview` las llamadas a /api. Por defecto, VITE_API_URL si es
# una URL completa, o http://localhost:3000. El build de QA (`pnpm qa:build`) usa VITE_API_URL=/api.
# API_PROXY_TARGET=http://localhost:3000

# Las mediciones de QA (docs/qa/informe-qa.md) leen estas variables de la terminal, no de este archivo:
#   QA_ADMIN_EMAIL / QA_ADMIN_PASSWORD  admin de desarrollo para medir el panel (si faltan, se saltea)
#   QA_BASE_URL     sitio a medir con Lighthouse (por defecto http://localhost:4173)
#   CHROME_PATH     otro Chromium para Lighthouse (por defecto, el de Playwright)
