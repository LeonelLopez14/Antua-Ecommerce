{
  "name": "antua-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test e2e/guest-checkout.spec.ts e2e/account-checkout.spec.ts e2e/admin.spec.ts --project=desktop --project=mobile",
    "test:e2e:deploy": "playwright test e2e/guest-checkout.spec.ts e2e/account-checkout.spec.ts e2e/admin.spec.ts e2e/csp.spec.ts --project=desktop",
    "qa:build": "tsc -b && VITE_API_URL=/api vite build",
    "qa:preview": "vite preview --port 4173 --strictPort",
    "qa:lighthouse": "node qa/lighthouse.ts",
    "qa:a11y": "playwright test e2e/a11y.spec.ts --project=desktop",
    "qa:keyboard": "playwright test e2e/keyboard.spec.ts --project=desktop",
    "qa:resilience": "playwright test e2e/resilience.spec.ts --project=desktop && playwright test e2e/guest-checkout.spec.ts --project=firefox",
    "qa:e2e": "playwright test e2e/a11y.spec.ts e2e/keyboard.spec.ts e2e/resilience.spec.ts --project=desktop --workers=1"
  },
  "dependencies": {
    "@fontsource/lato": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.3.2",
    "axios": "^1.18.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.2",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "lighthouse": "13.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
