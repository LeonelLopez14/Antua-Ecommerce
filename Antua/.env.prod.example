# Variables de docker-compose.prod.yml (producción o prueba de despliegue).
#
#   cp .env.prod.example .env.prod      # .env.prod NUNCA se versiona (está en .gitignore)
#   chmod 600 .env.prod                  # solo tu usuario lo puede leer
#   ./scripts/generate-secrets.sh        # genera los secretos para copiar acá
#
# TODOS los valores de abajo son de EJEMPLO. Los que dicen "EJEMPLO" son secretos falsos: la API
# se niega a arrancar con NODE_ENV=production si ve alguno (ver antua-api/src/config/env.validation.ts).

# --- Sitio y HTTPS -------------------------------------------------------------------------
# Nombre con el que se entra al sitio. Modo internal: localhost, un nombre de la red local
# (antojarte.lan) o una IP. Modo public: el dominio real (tienda.tu-dominio.com).
SITE_ADDRESS=localhost
# internal = certificado propio de Caddy (sin dominio público). public = Let's Encrypt + HSTS.
HTTPS_MODE=internal
# Solo modo public y obligatorio ahí: un correo REAL tuyo (Let's Encrypt rechaza .example).
ACME_EMAIL=
# URL pública del sitio: los links de los mails apuntan acá. Siempre HTTPS. Si el puerto no es
# 443, va en la URL (por ejemplo https://localhost:8443).
FRONTEND_URL=https://localhost

# --- Puertos (solo los publica el proxy) ----------------------------------------------------
# En qué interfaz escucha: 127.0.0.1 = solo esta máquina. 0.0.0.0 = toda la red (y, si el router
# lo permite, internet). Ver la guía antes de cambiarlo.
PROXY_BIND=127.0.0.1
# Puertos de HTTP y HTTPS. Modo public: tienen que ser 80 y 443. Si ya están ocupados en el
# servidor, usá otros (por ejemplo 8080 y 8443) en modo internal.
HTTP_PORT=80
HTTPS_PORT=443

# --- Base de datos --------------------------------------------------------------------------
# La base no publica ningún puerto (no choca con el MariaDB del 3306 ni con nada del host).
DB_DATABASE=antua_db
# Contraseña de root de MySQL: solo para administrar desde adentro del contenedor.
MYSQL_ROOT_PASSWORD=EJEMPLO-root-no-usar
# Usuario de la API: solo SELECT, INSERT, UPDATE y DELETE.
DB_APP_USER=antua_app
DB_APP_PASSWORD=EJEMPLO-app-no-usar
# Usuario de migraciones: puede cambiar el esquema. Solo lo usa `run --rm migrate`.
DB_MIGRATION_USER=antua_migrator
DB_MIGRATION_PASSWORD=EJEMPLO-migraciones-no-usar
# Usuario de respaldos: solo lectura.
DB_BACKUP_USER=antua_backup
DB_BACKUP_PASSWORD=EJEMPLO-respaldos-no-usar

# --- API ------------------------------------------------------------------------------------
# Al menos 32 caracteres aleatorios (scripts/generate-secrets.sh). Si cambia, todas las sesiones
# se cierran.
JWT_SECRET=EJEMPLO-jwt-no-usar-en-produccion-reemplazar-por-uno-aleatorio
JWT_EXPIRES_IN=7d
# Costo de envío fijo, en pesos uruguayos (UYU).
SHIPPING_FLAT_RATE=1500
# Plazo estimado de entrega en días (1 a 60). Vacío: no se muestra.
SHIPPING_ETA_DAYS=
# Solo si el front estuviera en OTRO dominio que la API. Con Caddy es el mismo: vacío.
CORS_ORIGINS=
# Cantidad de proxies delante de la API (Caddy = 1). No lo cambies salvo que agregues otro.
TRUST_PROXY=1
LOW_STOCK_THRESHOLD=5
# Los pagos (Mercado Pago) quedan deshabilitados en producción: este proyecto solo admite pagos
# de prueba, y la API se niega a activarlos con NODE_ENV=production.

# --- Imágenes y límites ---------------------------------------------------------------------
# Etiqueta de las imágenes construidas (antojarte-api:<tag>, antojarte-proxy:<tag>). Útil para
# volver a una versión anterior (rollback): ver la guía.
IMAGE_TAG=local
# Límites de memoria por contenedor.
DB_MEMORY_LIMIT=1g
API_MEMORY_LIMIT=512m
PROXY_MEMORY_LIMIT=256m

# --- Respaldos (scripts/backup-db.sh) -------------------------------------------------------
# Carpeta FUERA del repo donde se guardan. Días que se conservan.
BACKUP_DIR=/var/backups/antojarte
BACKUP_RETENTION_DAYS=14
