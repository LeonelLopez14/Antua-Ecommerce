# Base de datos: MySQL 8 en Docker (contenedor antua-mysql), publicado en 127.0.0.1:3307
# porque el 3306 puede estar ocupado por otro MySQL/MariaDB del sistema.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=tu_password
DB_DATABASE=antua_db

# JWT
# Al menos 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres
# Obligatoria: número y unidad (s, m, h o d).
JWT_EXPIRES_IN=7d

# Costo de envío fijo, en pesos. Obligatorio: número >= 0 (por ejemplo 1500).
# Si falta o no es un número, la API no arranca y avisa el motivo.
SHIPPING_FLAT_RATE=1500

# Plazo estimado de entrega, en días (entero de 1 a 60). Opcional: vacío, no se muestra un plazo.
SHIPPING_ETA_DAYS=3

# URL pública del front (se usa en los links de los mails). Por defecto, http://localhost:5173.
FRONTEND_URL=http://localhost:5173

# Orígenes permitidos por CORS, separados por coma. Nunca "*". Vacío: sin CORS (en desarrollo, Vite hace de proxy).
# Ejemplo: CORS_ORIGINS=https://tienda.ejemplo.com
CORS_ORIGINS=

# Clave para las escrituras del catálogo (POST/PATCH/DELETE de /products y /tags), en el header X-Admin-Key.
# Vacía: nadie puede usarlas. Generar con: openssl rand -hex 32
ADMIN_API_KEY=
