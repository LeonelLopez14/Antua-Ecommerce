# Base de datos: MySQL 8 en Docker (contenedor antua-mysql), publicado en 127.0.0.1:3307
# porque el 3306 puede estar ocupado por otro MySQL/MariaDB del sistema.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=tu_password
DB_DATABASE=antua_db

# JWT
# Al menos 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres
# Obligatoria: número y unidad (s, m, h o d).
JWT_EXPIRES_IN=7d

# Costo de envío fijo, en pesos. Obligatorio: número >= 0 (por ejemplo 1500).
# Si falta o no es un número, la API no arranca y avisa el motivo.
SHIPPING_FLAT_RATE=1500

# Plazo estimado de entrega, en días (entero de 1 a 60). Opcional: vacío, no se muestra un plazo.
SHIPPING_ETA_DAYS=3

# URL pública del front (se usa en los links de los mails). Por defecto, http://localhost:5173.
FRONTEND_URL=http://localhost:5173
# Nombre nuevo de lo mismo: URL pública para los enlaces de los correos. Si falta, se usa FRONTEND_URL.
PUBLIC_URL=

# --- Correo ---
# log (por defecto): no envía; escribe en el log el destinatario enmascarado, el asunto y los enlaces.
# smtp: envía por SMTP. En desarrollo, con Mailpit (docker compose --profile mail up -d mailpit):
#   MAIL_TRANSPORT=smtp MAIL_HOST=127.0.0.1 MAIL_PORT=1025 MAIL_FROM="Antojarte <pedidos@antojarte.example>"
#   y los correos se ven en http://127.0.0.1:8025
MAIL_TRANSPORT=log
MAIL_HOST=
MAIL_PORT=
# true: TLS directo (puerto 465). Vacío: true solo en el 465; en los demás, STARTTLS si el servidor lo ofrece.
MAIL_SECURE=
# Usuario y contraseña van juntos (Mailpit no los pide; en producción son obligatorios).
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Orígenes permitidos por CORS, separados por coma. Nunca "*". Vacío: sin CORS (en desarrollo, Vite hace de proxy).
# Ejemplo: CORS_ORIGINS=https://tienda.ejemplo.com
CORS_ORIGINS=

# Proxies delante de la API: vacío o false en desarrollo; 1 detrás de Caddy (docker-compose.prod.yml).
# Nunca "true": cualquiera podría inventarse una IP en X-Forwarded-For y saltear el límite de intentos.
TRUST_PROXY=

# --- Panel de administración ---
# Carpeta de las imágenes subidas (relativa a antua-api o absoluta). Nunca dentro de src/. Por defecto: uploads
UPLOADS_DIR=uploads
# Variantes con este stock o menos se marcan como "stock bajo" en el panel. Por defecto: 5
LOW_STOCK_THRESHOLD=5
# El primer admin se crea con `pnpm admin:create` (ver antua-web/docs/admin.md). No hay clave compartida.
# Solo desarrollo: si la definís, `pnpm seed` crea seed.admin@antua.test con esta contraseña. Sin valor por defecto.
SEED_ADMIN_PASSWORD=

# --- Pagos (Mercado Pago, SOLO credenciales de prueba) ---
# Sin MP_ACCESS_TOKEN ni MP_WEBHOOK_SECRET los pagos quedan deshabilitados y el checkout registra el pedido.
# Los valores reales los cargás vos; ver antua-web/docs/payments-design.md.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URLs públicas HTTPS (Mercado Pago no acepta localhost). Obligatorias si hay credenciales.
# Ejemplo: MP_PUBLIC_API_URL=https://api.ejemplo.test
MP_PUBLIC_API_URL=
MP_PUBLIC_FRONTEND_URL=
# Moneda de las preferencias. Por defecto, UYU.
PAYMENT_CURRENCY=UYU
# Horas que se reserva el stock esperando el pago. Por defecto, 48.
PAYMENT_EXPIRATION_HOURS=48
# Solo desarrollo: proveedor simulado (requiere MP_WEBHOOK_SECRET). Nunca junto con MP_ACCESS_TOKEN.
PAYMENTS_SIMULATED=
