# Variables de docker-compose.yml. Copiar a .env y completar.
# La API además lee antua-api/.env (copiar desde antua-api/.env.example).

# Contraseña de root de MySQL dentro de Docker.
DB_PASSWORD=reemplazar_por_una_contrasena_local
DB_DATABASE=antua_db

# Puertos publicados en la máquina. El de MySQL es 3307 porque el 3306 suele estar ocupado.
MYSQL_BIND=127.0.0.1
MYSQL_PORT=3307
API_BIND=127.0.0.1
API_PORT=3000
WEB_BIND=127.0.0.1
WEB_PORT=5173
